{
  "name": "tracer_goal_locomotion_v0",

  "num_envs": 4096,
  "episode_length_sec": 20.0,
  "control_dt": 0.02,
  "decimation": 4,

  "robot": {
    "name": "unitree_go1_or_a1",
    "base_frame": "base",
    "num_dofs": 12,
    "num_feet": 4
  },

  "goal_task": {
    "relative_goal": true,
    "goal_xy_range": {
      "x_min": 0.5,
      "x_max": 2.0,
      "y_min": -1.0,
      "y_max": 1.0
    },
    "success_tolerance": 0.30
  },

  "observation_dims": {
    "history_len": 40,
    "history_feature_dim": 11,
    "context_dim": 16,
    "goal_dim": 2,
    "tracer_output_dim": 11
  },

  "action_space": {
    "type": "joint_position_residual",
    "dim": 12,
    "clip": 1.0
  },

  "tracer_high_level": {
    "max_vx": 0.12,
    "max_yaw": 0.20,
    "latent_dim": 32,
    "theta_dim": 6
  },

  "terrain_randomization": {
    "use_flat": true,
    "use_rough": true,
    "use_slope": true,
    "friction_range": [0.4, 1.2],
    "roughness_range": [0.0, 0.08],
    "slope_range_deg": [-12.0, 12.0]
  },

  "reward_terms": {
    "goal_progress": 1.0,
    "velocity_tracking": 0.5,
    "yaw_tracking": 0.3,
    "stability": 0.5,
    "energy_penalty": -0.01,
    "fall_penalty": -5.0,
    "success_bonus": 5.0
  },

  "ram_teacher_labels": [
    "vx_tracking_error",
    "yaw_tracking_error",
    "foot_slip_proxy",
    "base_attitude_error",
    "contact_inconsistency",
    "terrain_friction",
    "terrain_slope",
    "terrain_roughness"
  ]
}
