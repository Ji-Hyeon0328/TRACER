      "candidate_vx_scale",
      "candidate_vx_delta",
      "candidate_yaw_gain",
      "candidate_body_h_delta",
      "candidate_clearance_delta"
    ],
    "routing_guard": [
      "active_used",
      "j7_accepted",
      "j7_projected",
      "j7_failsafe",
      "flat_rows",
      "flat_accepted",
      "flat_accept_rate"
    ],
    "outcome": [
      "status",
      "goal_reached",
      "final_x",
      "final_y",
      "max_abs_y",
      "mean_abs_y",
      "risk_score_lower_better",
      "delta_progress",
