{
  "phase": "L1",
  "name": "selector_dataset_schema_v0",
  "schema_version": "phase_l1_v0",
  "purpose": "Canonical schema for conservative data-backed meta-action candidate evaluation.",
  "current_seed_granularity": "rollout_candidate_outcome",
  "future_target_granularity": "state_context_candidate_action",
  "active_runtime_policy": "empirical_default",
  "learned_selector_runtime_mode": "shadow_only",
  "label_semantics": {
    "empirical": "Reference anchor. No candidate is promoted over the empirical/default action.",
    "reject": "Candidate is invalid, unsafe, unstable, or inferior.",
    "shadow_only": "Candidate is a plausible near-miss but lacks evidence for deployment.",
    "candidate_positive_later": "Reserved future label for candidates with repeatable evidence of improvement. Not present in the initial seed dataset."
  },
  "raw_label_mapping": {
    "reference": "empirical",
    "reject": "reject",
    "shadow_only": "shadow_only"
  },
  "supervision_roles": {
    "empirical": "reference_anchor",
    "reject": "negative",
    "shadow_only": "near_miss",
    "candidate_positive_later": "future_positive"
  },
  "feature_groups": {
    "provenance": [
      "source_phase",
      "source_row_index",
      "source_rollout_id",
      "manifest",
      "d5_log_dir",
      "j7_csv",
      "run_dir"
    ],
    "situation": [
      "world_name",
      "context_label",
      "next_context",
      "segment_id",
      "segment_progress",
      "x_start",
      "y_start",
      "abs_y_start"
    ],
    "objective_adaptation": [
      "beta_motion",
      "beta_stability",
      "beta_energy",
      "ram_rho_summary",
      "sigma_uncertainty"
    ],
    "baseline_action": [
      "baseline_vx",
      "baseline_yaw",
      "baseline_body_h",
      "baseline_clearance",
      "baseline_enable"
    ],
    "candidate_action": [
      "candidate_mode",
      "candidate_action_id",
      "candidate_theta_desc",
      "candidate_vx",
      "candidate_yaw",
      "candidate_body_h",
      "candidate_clearance",
